<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local-llm.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_ROOT__/bin/local-llm</string>
		<string>serve</string>
		<string>--config</string>
		<string>__REPO_ROOT__/config/models.yaml</string>
		<string>--env-file</string>
		<string>__REPO_ROOT__/.env</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/__USER__/Library/Logs/local-llm.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/__USER__/Library/Logs/local-llm.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
